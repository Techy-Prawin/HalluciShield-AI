# System Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Backend Configuration
BACKEND_PORT=4000
BACKEND_URL=http://localhost:4000
WORKSPACE_ROOT=/workspace

# AI Engine Configuration
AI_ENGINE_PORT=8000
AI_ENGINE_URL=http://localhost:8000

# LLM Provider (Groq - OpenAI-compatible) — get a key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
DEFAULT_LLM_MODEL=openai/gpt-oss-20b

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hallucishield_user
POSTGRES_PASSWORD=hallucishield_secure_pass_2026
POSTGRES_DB=hallucishield_db
DATABASE_URL=postgresql://hallucishield_user:hallucishield_secure_pass_2026@localhost:5432/hallucishield_db

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8000

# Docker Sandbox Configuration
SANDBOX_DOCKER_IMAGE=hallucishield-sandbox:latest
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

# Internal AI Engine Authentication (backend ↔ ai-engine) — generate a secure random value for production
HALLUCISHIELD_API_KEY=
